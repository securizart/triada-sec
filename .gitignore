# Basura de macOS
._*
.DS_Store
.AppleDouble
.LSOverride

# Temporales
*.swp
*~
/tmp/

# Nunca versionar credenciales ni keyrings binarios
*.key
*.gpg
*secret*
*password*

# Excepcion: las listas de paquetes contienen "password" en el nombre
# (grupo de cracking) pero NO son credenciales. Permitir explicitamente.
!profiles/*/packages/*password*.list
